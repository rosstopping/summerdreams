{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "alexwenzel/nova-dependency-container": "^1.12",
        "archtechx/laravel-seo": "^0.10.3",
        "aws/aws-sdk-php": "^3.283",
        "digizu/calendar": "@dev",
        "ebess/advanced-nova-media-library": "^5.1",
        "guzzlehttp/guzzle": "^7.8",
        "intervention/image": "^2.7",
        "laravel/folio": "^1.0",
        "laravel/framework": "^12.74",
        "laravel/horizon": "^5.21",
        "laravel/nova": "^5.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.8",
        "livewire/livewire": "^3.8",
        "maatwebsite/laravel-nova-excel": "^1.3",
        "mailchimp/marketing": "^3.0",
        "marshmallow/nova-tiptap": "^6.0.0",
        "mostafaznv/nova-laracache": "^1.0",
        "outl1ne/nova-menu-builder": "^8.0",
        "outl1ne/nova-simple-repeatable": "^3.0",
        "psr/simple-cache": "^2.0",
        "sentry/sentry-laravel": "^4.0",
        "spatie/laravel-googletagmanager": "^2.7",
        "spatie/laravel-honeypot": "^4.3",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-responsecache": "^7.4",
        "spatie/laravel-sitemap": "^7.0",
        "spatie/laravel-sluggable": "^3.5",
        "spatie/laravel-stripe-webhooks": "^3.5",
        "stripe/stripe-php": "^12.2",
        "whitecube/nova-flexible-content": "^2.0",
        "renatomarinho/laravel-page-speed": "^4.4",
        "digizu/seasonal-line-chart": "@dev",
        "bacon/bacon-qr-code": "^3.0"
    },
    "require-dev": {
        "beyondcode/laravel-dump-server": "^2.0",
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5",
        "spatie/laravel-ignition": "^2.4",
        "spatie/laravel-web-tinker": "^1.8"
    },
    "autoload": {
        "files": [
            "app/Helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --tag=nova-assets --force --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": {
        "nova": {
            "type": "composer",
            "url": "https://nova.laravel.com"
        },
        "0": {
            "type": "path",
            "url": "./nova-components/Calendar"
        },
        "1": {
            "type": "vcs",
            "url": "https://github.com/rosstopping/laravel-page-speed"
        },
        "seasonal-line-chart": {
            "type": "path",
            "url": "./nova-components/SeasonalLineChart"
        }
    }
}
